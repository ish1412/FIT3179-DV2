{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": {
            "expr": "'Same test, different states, 2026 · ' + (domain === 'All' ? 'average of subjects' : (domain === 'Grammar and Punctuation' ? 'Grammar & Punctuation' : domain))"
        },
        "subtitle": [
            "Each square = 1,000 students in a year level, so a state's size is how many students it has",
            "Colour = share of students at Strong or above"
        ],
        "subtitleColor": "#6B675F",
        "subtitleFontSize": 12,
        "subtitlePadding": 6
    },
    "width": 430,
    "height": 440,
    "params": [
        {
            "name": "domain",
            "value": "All"
        },
        {
            "name": "yearLevel",
            "value": 5
        }
    ],
    "layer": [
        {
            "description": "grey base square under every cell (shows where there is no result: TAS 2026)",
            "data": {
                "url": "data/cartogram_cells.json"
            },
            "transform": [
                {"calculate": "datum.col + 1", "as": "col2"},
                {"calculate": "datum.row + 1", "as": "row2"}
            ],
            "mark": {"type": "rect", "fill": "#C9C2B4", "stroke": "#FBF8F1", "strokeWidth": 0.7},
            "encoding": {
                "x": {"field": "col", "type": "quantitative", "scale": {"domain": [1.5, 26]}, "axis": null},
                "x2": {"field": "col2"},
                "y": {"field": "row", "type": "quantitative", "scale": {"domain": [0.5, 25.5], "reverse": true}, "axis": null},
                "y2": {"field": "row2"}
            }
        },
        {
            "description": "one rect per square, coloured by its state's % Strong or above",
            "data": {
                "url": "data/cartogram_cells.json"
            },
            "transform": [
                {"calculate": "datum.state + '|' + yearLevel + '|' + domain", "as": "key"},
                {
                    "lookup": "key",
                    "from": {
                        "data": {"url": "data/naplan_2026_state_pct.csv", "format": {"type": "csv", "parse": {"pct": "number"}}},
                        "key": "key",
                        "fields": ["pct"]
                    }
                },
                {"calculate": "datum.col + 1", "as": "col2"},
                {"calculate": "datum.row + 1", "as": "row2"}
            ],
            "params": [
                {
                    "name": "pickState",
                    "select": {"type": "point", "fields": ["state"], "on": "click", "clear": "dblclick"}
                }
            ],
            "mark": {"type": "rect", "stroke": "#FBF8F1", "strokeWidth": 0.7, "cursor": "pointer"},
            "encoding": {
                "x": {"field": "col", "type": "quantitative", "scale": {"domain": [1.5, 26]}, "axis": null},
                "x2": {"field": "col2"},
                "y": {"field": "row", "type": "quantitative", "scale": {"domain": [0.5, 25.5], "reverse": true}, "axis": null},
                "y2": {"field": "row2"},
                "color": {
                    "condition": {
                        "test": "isValid(datum.pct)",
                        "field": "pct",
                        "type": "quantitative",
                        "title": "% Strong or above",
                        "scale": {"domain": [0, 80], "range": ["#D6E2EE", "#1E3F60"], "interpolate": "lab"},
                        "legend": {"orient": "bottom-left", "direction": "horizontal", "gradientLength": 150, "values": [0, 20, 40, 60, 80]}
                    },
                    "value": null
                },
                "opacity": {
                    "condition": {"param": "pickState", "value": 1},
                    "value": 0.35
                },
                "tooltip": [
                    {"field": "state", "title": "State"},
                    {"field": "pct", "title": "% Strong or above", "format": ".1f"}
                ]
            }
        },
        {
            "description": "state borders and coastline",
            "data": {
                "url": "data/cartogram_edges.json"
            },
            "mark": {"type": "rule", "color": "#2B2A28", "strokeCap": "square"},
            "encoding": {
                "x": {"field": "x", "type": "quantitative"},
                "x2": {"field": "x2"},
                "y": {"field": "y", "type": "quantitative"},
                "y2": {"field": "y2"},
                "strokeWidth": {"condition": {"test": "datum.coast", "value": 1.2}, "value": 1.6}
            }
        },
        {
            "description": "labels: state and % (one line for small states)",
            "data": {
                "url": "data/cartogram_labels.json"
            },
            "transform": [
                {"calculate": "datum.state + '|' + yearLevel + '|' + domain", "as": "key"},
                {
                    "lookup": "key",
                    "from": {
                        "data": {"url": "data/naplan_2026_state_pct.csv", "format": {"type": "csv", "parse": {"pct": "number"}}},
                        "key": "key",
                        "fields": ["pct"]
                    }
                },
                {"calculate": "isValid(datum.pct) ? format(datum.pct, '.0f') + '%' : 'not published'", "as": "pctText"},
                {"calculate": "!datum.outside && datum.pct > 45", "as": "light"}
            ],
            "encoding": {
                "x": {"field": "cx", "type": "quantitative"},
                "y": {"field": "cy", "type": "quantitative"},
                "color": {"condition": {"test": "datum.light", "value": "#FFFFFF"}, "value": "#2B2A28"}
            },
            "layer": [
                {
                    "transform": [{"filter": "!datum.oneLine"}],
                    "layer": [
                        {
                            "mark": {"type": "text", "fontSize": 15, "fontWeight": 700, "dy": -8},
                            "encoding": {"text": {"field": "state"}}
                        },
                        {
                            "mark": {"type": "text", "fontSize": 14, "dy": 9},
                            "encoding": {"text": {"field": "pctText"}}
                        }
                    ]
                },
                {
                    "transform": [
                        {"filter": "datum.oneLine"},
                        {"calculate": "datum.state + ' ' + datum.pctText", "as": "line"}
                    ],
                    "mark": {"type": "text", "fontSize": 11, "fontWeight": 700},
                    "encoding": {"text": {"field": "line"}}
                }
            ]
        }
    ]
}
