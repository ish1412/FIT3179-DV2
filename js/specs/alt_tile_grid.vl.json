{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": {
            "expr": "'Same test, different states, 2026 · ' + (domain === 'All' ? 'average of subjects' : (domain === 'Grammar and Punctuation' ? 'Grammar & Punctuation' : domain))"
        },
        "subtitle": "One equal-sized tile per state, placed roughly where it sits on the map",
        "subtitleColor": "#6B675F",
        "subtitleFontSize": 12,
        "subtitlePadding": 6
    },
    "width": 400,
    "height": 400,
    "params": [
        {
            "name": "domain",
            "value": "All"
        },
        {
            "name": "yearLevel",
            "value": 5
        }
    ],
    "encoding": {
        "x": {
            "field": "x",
            "type": "quantitative",
            "scale": {"domain": [0, 4]},
            "axis": null
        },
        "y": {
            "field": "y",
            "type": "quantitative",
            "scale": {"domain": [0, 4], "reverse": true},
            "axis": null
        }
    },
    "layer": [
        {
            "description": "grey tile for every state (shows through where there is no result: TAS 2026)",
            "data": {
                "url": "data/state_tiles.json"
            },
            "transform": [
                {"calculate": "datum.col + 0.04", "as": "x"},
                {"calculate": "datum.col + 0.96", "as": "x2"},
                {"calculate": "datum.row + 0.04", "as": "y"},
                {"calculate": "datum.row + 0.96", "as": "y2"}
            ],
            "mark": {"type": "rect", "cornerRadius": 4, "fill": "#DEDAD2"},
            "encoding": {
                "x2": {"field": "x2"},
                "y2": {"field": "y2"}
            }
        },
        {
            "description": "TAS label (no 2026 result)",
            "data": {
                "url": "data/state_tiles.json"
            },
            "transform": [
                {"filter": "datum.state === 'TAS'"},
                {"calculate": "datum.col + 0.5", "as": "x"},
                {"calculate": "datum.row + 0.5", "as": "y"}
            ],
            "layer": [
                {
                    "mark": {"type": "text", "fontSize": 15, "fontWeight": 700, "dy": -9, "color": "#2B2A28"},
                    "encoding": {"text": {"field": "state"}}
                },
                {
                    "mark": {"type": "text", "fontSize": 11, "dy": 10, "color": "#6B675F"},
                    "encoding": {"text": {"value": "not published"}}
                }
            ]
        },
        {
            "description": "coloured tiles: % Strong or above in 2026 for the chosen subject and year level",
            "data": {
                "url": "data/naplan_2023_2026_states.csv",
                "format": {
                    "type": "csv",
                    "parse": {"year": "number", "year_level": "number", "pct_strong_or_above": "number"}
                }
            },
            "transform": [
                {"filter": "datum.year === 2026 && datum.state !== 'AUS' && (domain === 'All' || datum.domain === domain) && datum.year_level === yearLevel"},
                {"aggregate": [{"op": "mean", "field": "pct_strong_or_above", "as": "pct"}], "groupby": ["state", "state_name"]},
                {
                    "lookup": "state",
                    "from": {
                        "data": {"url": "data/state_tiles.json"},
                        "key": "state",
                        "fields": ["col", "row"]
                    }
                },
                {"calculate": "datum.col + 0.04", "as": "x"},
                {"calculate": "datum.col + 0.96", "as": "x2"},
                {"calculate": "datum.row + 0.04", "as": "y"},
                {"calculate": "datum.row + 0.96", "as": "y2"},
                {"calculate": "datum.col + 0.5", "as": "cx"},
                {"calculate": "datum.row + 0.5", "as": "cy"},
                {"calculate": "format(datum.pct, '.0f') + '%'", "as": "label"}
            ],
            "layer": [
                {
                    "params": [
                        {
                            "name": "pickState",
                            "select": {"type": "point", "fields": ["state"], "on": "click", "clear": "dblclick"}
                        }
                    ],
                    "mark": {"type": "rect", "cornerRadius": 4, "cursor": "pointer", "strokeWidth": 3},
                    "encoding": {
                        "x2": {"field": "x2"},
                        "y2": {"field": "y2"},
                        "color": {
                            "field": "pct",
                            "type": "quantitative",
                            "title": "% Strong or above",
                            "scale": {"domain": [0, 80], "range": ["#D6E2EE", "#1E3F60"], "interpolate": "lab"},
                            "legend": {"orient": "bottom-left", "direction": "horizontal", "gradientLength": 150, "values": [0, 20, 40, 60, 80]}
                        },
                        "stroke": {
                            "condition": {"param": "pickState", "empty": false, "value": "#C8652B"},
                            "value": null
                        },
                        "tooltip": [
                            {"field": "state_name", "title": "State"},
                            {"field": "pct", "title": "% Strong or above", "format": ".1f"}
                        ]
                    }
                },
                {
                    "mark": {"type": "text", "fontSize": 15, "fontWeight": 700, "dy": -9},
                    "encoding": {
                        "x": {"field": "cx", "type": "quantitative"},
                        "y": {"field": "cy", "type": "quantitative"},
                        "text": {"field": "state"},
                        "color": {"condition": {"test": "datum.pct > 45", "value": "#FFFFFF"}, "value": "#2B2A28"}
                    }
                },
                {
                    "mark": {"type": "text", "fontSize": 14, "dy": 10},
                    "encoding": {
                        "x": {"field": "cx", "type": "quantitative"},
                        "y": {"field": "cy", "type": "quantitative"},
                        "text": {"field": "label"},
                        "color": {"condition": {"test": "datum.pct > 45", "value": "#FFFFFF"}, "value": "#2B2A28"}
                    }
                }
            ]
        }
    ]
}
