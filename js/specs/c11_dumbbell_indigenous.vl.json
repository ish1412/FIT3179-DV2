{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": {
            "expr": "['The gap grows with distance', (domain === 'All' ? 'Average of subjects' : (domain === 'Grammar and Punctuation' ? 'Grammar & Punctuation' : domain))]"
        }
    },
    "width": 210,
    "height": 190,
    "params": [
        {
            "name": "domain",
            "value": "Reading"
        },
        {
            "name": "yearLevel",
            "value": 5
        }
    ],
    "data": {
        "url": "data/naplan_2023_2026_subgroups_aus.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year": "number",
                "year_level": "number",
                "pct_strong_or_above": "number",
                "enrolled": "number"
            }
        }
    },
    "transform": [
        {
            "filter": "datum.year === 2026 && datum.attribute === 'Indigeneity by ABS remoteness' && (domain === 'All' || datum.domain === domain) && datum.year_level === yearLevel"
        },
        {
            "aggregate": [
                {
                    "op": "mean",
                    "field": "pct_strong_or_above",
                    "as": "pct_strong_or_above"
                },
                {
                    "op": "mean",
                    "field": "enrolled",
                    "as": "enrolled"
                }
            ],
            "groupby": [
                "subgroup"
            ]
        },
        {
            "calculate": "indexof(datum.subgroup, 'Non-Indigenous') === 0 ? 'Non-Indigenous' : 'Indigenous'",
            "as": "group"
        },
        {
            "calculate": "substring(datum.subgroup, length(datum.group) + 1)",
            "as": "rawRemoteness"
        },
        {
            "calculate": "upper(substring(datum.rawRemoteness, 0, 1)) + substring(datum.rawRemoteness, 1)",
            "as": "remoteness"
        },
        {
            "joinaggregate": [
                {
                    "op": "max",
                    "field": "pct_strong_or_above",
                    "as": "hi"
                },
                {
                    "op": "min",
                    "field": "pct_strong_or_above",
                    "as": "lo"
                }
            ],
            "groupby": [
                "remoteness"
            ]
        },
        {
            "calculate": "datum.hi - datum.lo",
            "as": "gap"
        },
        {
            "joinaggregate": [
                {
                    "op": "max",
                    "field": "gap",
                    "as": "maxGap"
                }
            ]
        },
        {
            "calculate": "datum.gap === datum.maxGap",
            "as": "isFocus"
        }
    ],
    "encoding": {
        "y": {
            "field": "remoteness",
            "type": "nominal",
            "title": null,
            "sort": {
                "field": "gap",
                "order": "ascending"
            },
            "axis": {
                "domain": false,
                "ticks": false,
                "labelPadding": 6
            }
        }
    },
    "layer": [
        {
            "transform": [
                {
                    "filter": "datum.group === 'Indigenous'"
                }
            ],
            "mark": {
                "type": "rule",
                "color": "#BDB6A8",
                "strokeWidth": 3
            },
            "encoding": {
                "x": {
                    "field": "lo",
                    "type": "quantitative"
                },
                "x2": {
                    "field": "hi"
                },
                "opacity": {
                    "condition": {
                        "test": "datum.isFocus",
                        "value": 1
                    },
                    "value": 0.72
                },
                "strokeWidth": {
                    "condition": {
                        "test": "datum.isFocus",
                        "value": 4
                    },
                    "value": 2.5
                }
            }
        },
        {
            "mark": {
                "type": "circle",
                "size": 110,
                "opacity": 1
            },
            "encoding": {
                "x": {
                    "field": "pct_strong_or_above",
                    "type": "quantitative",
                    "title": "% at Strong or Exceeding",
                    "scale": {
                        "domain": [
                            0,
                            100
                        ]
                    }
                },
                "color": {
                    "field": "group",
                    "type": "nominal",
                    "title": null,
                    "scale": {
                        "domain": [
                            "Indigenous",
                            "Non-Indigenous"
                        ],
                        "range": [
                            "#1E8A80",
                            "#6A4C93"
                        ]
                    },
                    "legend": {
                        "orient": "top",
                        "direction": "horizontal"
                    }
                },
                "tooltip": [
                    {
                        "field": "remoteness",
                        "title": "Remoteness"
                    },
                    {
                        "field": "group",
                        "title": "Students"
                    },
                    {
                        "field": "pct_strong_or_above",
                        "title": "% Strong or Exceeding",
                        "format": ".1f"
                    },
                    {
                        "field": "enrolled",
                        "title": "Students enrolled"
                    },
                    {
                        "field": "gap",
                        "title": "Gap (percentage points)",
                        "format": ".1f"
                    }
                ],
                "opacity": {
                    "condition": {
                        "test": "datum.isFocus",
                        "value": 1
                    },
                    "value": 0.72
                },
                "size": {
                    "condition": {
                        "test": "datum.isFocus",
                        "value": 170
                    },
                    "value": 90
                }
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.group === 'Non-Indigenous'"
                }
            ],
            "mark": {
                "type": "text",
                "align": "left",
                "dx": 9,
                "fontSize": 10,
                "color": "#6B675F",
                "fontWeight": "bold"
            },
            "encoding": {
                "x": {
                    "field": "hi",
                    "type": "quantitative"
                },
                "text": {
                    "field": "gap",
                    "type": "quantitative",
                    "format": ".0f"
                },
                "opacity": {
                    "condition": {
                        "test": "datum.isFocus",
                        "value": 1
                    },
                    "value": 0.85
                },
                "fontWeight": {
                    "condition": {
                        "test": "datum.isFocus",
                        "value": "bold"
                    },
                    "value": "normal"
                },
                "fontSize": {
                    "condition": {
                        "test": "datum.isFocus",
                        "value": 13
                    },
                    "value": 11
                }
            }
        },
        {
            "data": {
                "values": [
                    {
                        "t": "number = gap in percentage points"
                    }
                ]
            },
            "mark": {
                "type": "text",
                "align": "right",
                "baseline": "bottom",
                "fontSize": 10,
                "color": "#6B675F"
            },
            "encoding": {
                "x": {
                    "value": 210
                },
                "y": {
                    "value": -4
                },
                "text": {
                    "field": "t"
                }
            }
        },
        {
            "description": "callout beside the biggest-gap row (worked out from the data); adds the 2-in-3 fact when that row is Very remote",
            "transform": [
                {
                    "filter": "datum.isFocus && datum.group === 'Indigenous'"
                },
                {
                    "calculate": "datum.remoteness === 'Very remote' ? ['Only ' + format(datum.pct_strong_or_above, '.0f') + '% of Indigenous', 'students here reach', 'Strong. 2 in 3 very', 'remote students are', 'Indigenous.'] : ['Only ' + format(datum.pct_strong_or_above, '.0f') + '% of Indigenous', 'students here reach', 'Strong.']",
                    "as": "lines"
                }
            ],
            "layer": [
                {
                    "mark": {
                        "type": "rule",
                        "color": "#2B2A28",
                        "strokeWidth": 1.2
                    },
                    "encoding": {
                        "x": {
                            "datum": 72
                        },
                        "y2": {
                            "value": {
                                "expr": "height * 0.62 + 84"
                            }
                        }
                    }
                },
                {
                    "mark": {
                        "type": "rule",
                        "color": "#2B2A28",
                        "strokeWidth": 1.2
                    },
                    "encoding": {
                        "x": {
                            "datum": 72
                        },
                        "x2": {
                            "datum": 61.5
                        }
                    }
                },
                {
                    "mark": {
                        "type": "point",
                        "shape": "triangle-left",
                        "filled": true,
                        "size": 55,
                        "color": "#2B2A28",
                        "opacity": 1
                    },
                    "encoding": {
                        "x": {
                            "datum": 61
                        }
                    }
                },
                {
                    "mark": {
                        "type": "rect",
                        "fill": "#FFFFFF",
                        "stroke": "#2B2A28",
                        "strokeWidth": 1,
                        "cornerRadius": 3
                    },
                    "encoding": {
                        "x": {
                            "datum": 65
                        },
                        "x2": {
                            "datum": 100
                        },
                        "y": {
                            "value": {
                                "expr": "height * 0.62"
                            }
                        },
                        "y2": {
                            "value": {
                                "expr": "height * 0.62 + 84"
                            }
                        }
                    }
                },
                {
                    "mark": {
                        "type": "text",
                        "align": "left",
                        "baseline": "top",
                        "fontSize": 10.5,
                        "lineHeight": 13.5,
                        "color": "#2B2A28",
                        "dx": 6
                    },
                    "encoding": {
                        "x": {
                            "datum": 65
                        },
                        "y": {
                            "value": {
                                "expr": "height * 0.62 + 8"
                            }
                        },
                        "text": {
                            "field": "lines"
                        }
                    }
                }
            ]
        }
    ]
}
