{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": {
            "expr": "'Where the students below Strong are · ' + (domain === 'All' ? 'average of subjects' : (domain === 'Grammar and Punctuation' ? 'Grammar & Punctuation' : domain))"
        },
        "subtitle": ["1 dot = about 500 students, placed at their school", "Share of orange dots = share below Strong in that state and remoteness zone"],
        "subtitleColor": "#6B675F",
        "subtitleFontSize": 12,
        "subtitlePadding": 6
    },
    "width": 440,
    "height": 430,
    "params": [
        {
            "name": "domain",
            "value": "All"
        },
        {
            "name": "yearLevel",
            "value": 5
        }
    ],
    "projection": {
        "type": "conicEqualArea",
        "parallels": [-18, -36],
        "rotate": [-132, 0]
    },
    "layer": [
        {
            "data": {
                "url": "data/aus_states.geojson",
                "format": {"type": "json", "property": "features"}
            },
            "mark": {"type": "geoshape", "fill": "#ECE7DD", "stroke": "#FBF8F1", "strokeWidth": 1}
        },
        {
            "data": {
                "url": "data/dots_schools_2025.csv",
                "format": {"type": "csv", "parse": {"lon": "number", "lat": "number", "u": "number"}}
            },
            "transform": [
                {"calculate": "datum.geo_key + '|' + yearLevel + '|' + domain", "as": "key"},
                {
                    "lookup": "key",
                    "from": {
                        "data": {"url": "data/naplan_2026_zone_below.csv", "format": {"type": "csv", "parse": {"pct_below": "number"}}},
                        "key": "key",
                        "fields": ["pct_below"]
                    }
                },
                {"calculate": "!isValid(datum.pct_below) ? 'No 2026 result' : (datum.u * 100 < datum.pct_below ? 'Below Strong' : 'Strong or above')", "as": "group"}
            ],
            "mark": {"type": "circle", "size": 8, "opacity": 0.7},
            "encoding": {
                "longitude": {"field": "lon", "type": "quantitative"},
                "latitude": {"field": "lat", "type": "quantitative"},
                "color": {
                    "field": "group",
                    "type": "nominal",
                    "title": null,
                    "scale": {
                        "domain": ["Below Strong", "Strong or above", "No 2026 result"],
                        "range": ["#C8652B", "#2F5D8A", "#BDB6A8"]
                    },
                    "legend": {"orient": "bottom-left", "symbolType": "circle", "symbolSize": 60, "labelFontSize": 12}
                },
                "tooltip": [
                    {"field": "geo_key", "title": "State | zone"},
                    {"field": "pct_below", "title": "% below Strong in this zone", "format": ".1f"}
                ]
            }
        }
    ]
}
