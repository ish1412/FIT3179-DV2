{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": "About 1 in 3 not yet at Strong"
    },
    "width": 200,
    "height": 200,
    "params": [
        {
            "name": "domain",
            "value": "Reading"
        },
        {
            "name": "yearLevel",
            "value": 5
        }
    ],
    "data": {
        "url": "data/naplan_2026_proficiency_long.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year_level": "number",
                "pct": "number",
                "level_order": "number"
            }
        }
    },
    "transform": [
        {
            "filter": "datum.state === 'AUS' && (domain === 'All' || datum.domain === domain) && datum.year_level === yearLevel && datum.level !== 'Exempt'"
        },
        {
            "aggregate": [
                {
                    "op": "mean",
                    "field": "pct",
                    "as": "pct"
                }
            ],
            "groupby": [
                "level",
                "level_order"
            ]
        },
        {
            "joinaggregate": [
                {
                    "op": "sum",
                    "field": "pct",
                    "as": "total"
                }
            ]
        },
        {
            "calculate": "datum.pct / datum.total * 100",
            "as": "share"
        }
    ],
    "layer": [
        {
            "transform": [
                {
                    "window": [
                        {
                            "op": "sum",
                            "field": "share",
                            "as": "cum"
                        }
                    ],
                    "sort": [
                        {
                            "field": "level_order",
                            "order": "descending"
                        }
                    ],
                    "frame": [
                        null,
                        0
                    ]
                },
                {
                    "calculate": "sequence(round(datum.cum - datum.share), round(datum.cum))",
                    "as": "idx"
                },
                {
                    "flatten": [
                        "idx"
                    ]
                },
                {
                    "calculate": "datum.idx % 10",
                    "as": "col"
                },
                {
                    "calculate": "floor(datum.idx / 10)",
                    "as": "row"
                }
            ],
            "mark": {
                "type": "rect",
                "cornerRadius": 2
            },
            "encoding": {
                "x": {
                    "field": "col",
                    "type": "ordinal",
                    "axis": null,
                    "scale": {
                        "paddingInner": 0.18
                    }
                },
                "y": {
                    "field": "row",
                    "type": "ordinal",
                    "axis": null,
                    "scale": {
                        "paddingInner": 0.18
                    }
                },
                "color": {
                    "field": "level",
                    "type": "nominal",
                    "title": null,
                    "scale": {
                        "domain": [
                            "Exceeding",
                            "Strong",
                            "Developing",
                            "Needs additional support"
                        ],
                        "range": [
                            "#2F5D8A",
                            "#9DB8D3",
                            "#E8B48F",
                            "#C8652B"
                        ]
                    },
                    "legend": null
                },
                "tooltip": [
                    {
                        "field": "level",
                        "title": "Level"
                    },
                    {
                        "field": "pct",
                        "title": "% of students",
                        "format": ".1f"
                    }
                ]
            }
        }
    ]
}
