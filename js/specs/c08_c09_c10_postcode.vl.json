{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "params": [
        {
            "name": "domain",
            "value": "Reading"
        },
        {
            "name": "yearLevel",
            "value": 5
        },
        {
            "name": "focusState",
            "value": "All"
        }
    ],
    "spacing": 28,
    "resolve": {
        "scale": {
            "color": "independent",
            "size": "independent"
        },
        "legend": {
            "color": "independent",
            "size": "independent"
        }
    },
    "hconcat": [
        {
            "title": {
                "text": "Thousands of schools, very different starting lines",
                "fontSize": 26
            },
            "width": 470,
            "height": 430,
            "projection": {
                "type": "conicEqualArea",
                "parallels": [
                    -18,
                    -36
                ],
                "rotate": [
                    -132,
                    0
                ]
            },
            "layer": [
                {
                    "data": {
                        "url": "data/aus_states.geojson",
                        "format": {
                            "type": "json",
                            "property": "features"
                        }
                    },
                    "transform": [
                        {
                            "filter": "focusState === 'All' || datum.properties.state_abbr === focusState"
                        },
                        {
                            "calculate": "datum.properties.state_abbr",
                            "as": "state"
                        }
                    ],
                    "mark": {
                        "type": "geoshape",
                        "fill": "#ECE7DD",
                        "stroke": "#FFFFFF",
                        "strokeWidth": 1,
                        "cursor": "pointer"
                    },
                    "params": [
                        {
                            "name": "clickState",
                            "select": {
                                "type": "point",
                                "fields": [
                                    "state"
                                ],
                                "on": "click",
                                "clear": "dblclick"
                            }
                        }
                    ]
                },
                {
                    "data": {
                        "url": "data/schools_2025.csv",
                        "format": {
                            "type": "csv",
                            "parse": {
                                "lat": "number",
                                "lon": "number",
                                "icsea": "number",
                                "enrolments": "number"
                            }
                        }
                    },
                    "transform": [
                        {
                            "filter": "isValid(datum.icsea) && isValid(datum.lat)"
                        },
                        {
                            "filter": "(focusState === 'All' || (datum.state === focusState && !(focusState === 'ACT' && +datum.lon > 149.5)))"
                        },
                        {
                            "filter": "!length(data('brush_store')) || (vlSelectionTest('brush_store', datum) && indexof(data('brush_store')[0].unit, '_facet_row_' + datum.remoteness + ' (') >= 0)"
                        }
                    ],
                    "mark": {
                        "type": "circle",
                        "opacity": 0.75,
                        "stroke": null,
                        "cursor": "pointer"
                    },
                    "encoding": {
                        "longitude": {
                            "field": "lon",
                            "type": "quantitative"
                        },
                        "latitude": {
                            "field": "lat",
                            "type": "quantitative"
                        },
                        "size": {
                            "field": "enrolments",
                            "type": "quantitative",
                            "title": "Enrolments",
                            "scale": {
                                "domain": [
                                    0,
                                    6300
                                ],
                                "range": [
                                    5,
                                    240
                                ]
                            },
                            "legend": {
                                "orient": "bottom-left",
                                "direction": "horizontal",
                                "values": [
                                    100,
                                    1000,
                                    3000
                                ],
                                "offset": 0,
                                "padding": 8,
                                "columnPadding": 22,
                                "labelOffset": 8,
                                "titlePadding": 8,
                                "fillColor": "#FBF8F1",
                                "symbolFillColor": "#A39E94",
                                "symbolStrokeWidth": 0
                            }
                        },
                        "color": {
                            "field": "icsea",
                            "type": "quantitative",
                            "title": "ICSEA",
                            "scale": {
                                "domain": [
                                    800,
                                    1000,
                                    1200
                                ],
                                "range": [
                                    "#B8322A",
                                    "#F2EEE6",
                                    "#2F5D8A"
                                ],
                                "clamp": true,
                                "interpolate": "lab"
                            },
                            "legend": {
                                "orient": "top-right",
                                "direction": "horizontal",
                                "gradientLength": 120,
                                "values": [
                                    800,
                                    1000,
                                    1200
                                ]
                            }
                        },
                        "order": {
                            "field": "enrolments",
                            "type": "quantitative",
                            "sort": "descending"
                        },
                        "tooltip": [
                            {
                                "field": "name",
                                "title": "School"
                            },
                            {
                                "field": "sector",
                                "title": "Sector"
                            },
                            {
                                "field": "type",
                                "title": "Type"
                            },
                            {
                                "field": "remoteness",
                                "title": "Remoteness"
                            },
                            {
                                "field": "icsea",
                                "title": "ICSEA",
                                "format": "d"
                            },
                            {
                                "field": "enrolments",
                                "title": "Enrolments",
                                "format": ","
                            }
                        ]
                    },
                    "params": [
                        {
                            "name": "clickSchool",
                            "select": {
                                "type": "point",
                                "fields": [
                                    "state"
                                ],
                                "on": "click",
                                "clear": "dblclick"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "spacing": 30,
            "resolve": {
                "scale": {
                    "color": "independent"
                }
            },
            "vconcat": [
                {
                    "title": {
                        "text": "Remote schools skew disadvantaged",
                        "subtitle": "Drag across the bars to show only those schools on the map above",
                        "subtitleColor": "#6B675F",
                        "subtitleFontSize": 13,
                        "subtitlePadding": 6
                    },
                    "data": {
                        "url": "data/schools_2025.csv",
                        "format": {
                            "type": "csv",
                            "parse": {
                                "icsea": "number"
                            }
                        }
                    },
                    "transform": [
                        {
                            "filter": "isValid(datum.icsea)"
                        },
                        {
                            "filter": "(focusState === 'All' || (datum.state === focusState && !(focusState === 'ACT' && +datum.lon > 149.5)))"
                        },
                        {
                            "joinaggregate": [
                                {
                                    "op": "count",
                                    "as": "rowSchools"
                                }
                            ],
                            "groupby": [
                                "remoteness"
                            ]
                        },
                        {
                            "calculate": "datum.remoteness + ' (' + format(datum.rowSchools, ',') + ')'",
                            "as": "rowLabel"
                        },
                        {
                            "calculate": "indexof([\"Major cities\", \"Inner regional\", \"Outer regional\", \"Remote\", \"Very remote\"], datum.remoteness)",
                            "as": "rowOrder"
                        },
                        {
                            "bin": {
                                "extent": [
                                    500,
                                    1300
                                ],
                                "step": 25
                            },
                            "field": "icsea",
                            "as": [
                                "icsea",
                                "icseaEnd"
                            ]
                        },
                        {
                            "aggregate": [
                                {
                                    "op": "count",
                                    "as": "n"
                                }
                            ],
                            "groupby": [
                                "remoteness",
                                "rowLabel",
                                "rowOrder",
                                "rowSchools",
                                "icsea",
                                "icseaEnd"
                            ]
                        },
                        {
                            "calculate": "datum.n / datum.rowSchools",
                            "as": "share"
                        },
                        {
                            "calculate": "(datum.icsea + datum.icseaEnd) / 2",
                            "as": "binMid"
                        }
                    ],
                    "facet": {
                        "row": {
                            "field": "rowLabel",
                            "type": "nominal",
                            "title": null,
                            "sort": {
                                "field": "rowOrder"
                            },
                            "header": {
                                "labelAngle": 0,
                                "labelOrient": "left",
                                "labelAlign": "left",
                                "labelAnchor": "middle",
                                "labelFontSize": 11,
                                "labelPadding": 8
                            }
                        }
                    },
                    "spacing": 6,
                    "resolve": {
                        "scale": {
                            "y": "shared"
                        }
                    },
                    "spec": {
                        "width": 215,
                        "height": 40,
                        "layer": [
                            {
                                "params": [
                                    {
                                        "name": "brush",
                                        "select": {
                                            "type": "interval",
                                            "encodings": [
                                                "x"
                                            ],
                                            "on": "[pointerdown, window:pointerup] > window:pointermove!{40}",
                                            "translate": "[pointerdown, window:pointerup] > window:pointermove!{40}"
                                        }
                                    }
                                ],
                                "mark": {
                                    "type": "bar",
                                    "binSpacing": 1
                                },
                                "encoding": {
                                    "x": {
                                        "field": "icsea",
                                        "type": "quantitative",
                                        "bin": {
                                            "binned": true,
                                            "step": 25
                                        },
                                        "title": "School ICSEA (1000 = Australian average)",
                                        "scale": {
                                            "domain": [
                                                500,
                                                1300
                                            ]
                                        },
                                        "axis": {
                                            "values": [
                                                600,
                                                800,
                                                1000,
                                                1200
                                            ],
                                            "grid": false
                                        }
                                    },
                                    "x2": {
                                        "field": "icseaEnd"
                                    },
                                    "y": {
                                        "field": "share",
                                        "type": "quantitative",
                                        "title": null,
                                        "axis": null
                                    },
                                    "color": {
                                        "field": "binMid",
                                        "type": "quantitative",
                                        "legend": null,
                                        "scale": {
                                            "domain": [
                                                800,
                                                1000,
                                                1200
                                            ],
                                            "range": [
                                                "#B8322A",
                                                "#D9D2C5",
                                                "#2F5D8A"
                                            ],
                                            "clamp": true,
                                            "interpolate": "lab"
                                        }
                                    },
                                    "tooltip": [
                                        {
                                            "field": "remoteness",
                                            "title": "Remoteness"
                                        },
                                        {
                                            "field": "icsea",
                                            "title": "ICSEA from",
                                            "format": "d"
                                        },
                                        {
                                            "field": "icseaEnd",
                                            "title": "ICSEA to",
                                            "format": "d"
                                        },
                                        {
                                            "field": "n",
                                            "title": "Schools"
                                        },
                                        {
                                            "field": "share",
                                            "title": "Share of this row",
                                            "format": ".1%"
                                        }
                                    ]
                                }
                            },
                            {
                                "mark": {
                                    "type": "rule",
                                    "color": "#2B2A28",
                                    "strokeDash": [
                                        3,
                                        2
                                    ],
                                    "strokeWidth": 1
                                },
                                "encoding": {
                                    "x": {
                                        "datum": 1000
                                    }
                                }
                            }
                        ]
                    }
                },
                {
                    "title": {
                        "text": {
                            "expr": "'The further out, the fewer at Strong · ' + (domain === 'All' ? 'average of subjects' : (domain === 'Grammar and Punctuation' ? 'Grammar & Punctuation' : domain))"
                        },
                        "subtitle": " ",
                        "subtitleFontSize": 13,
                        "subtitlePadding": 6
                    },
                    "width": 215,
                    "height": 190,
                    "projection": {
                        "type": "conicEqualArea",
                        "parallels": [
                            -18,
                            -36
                        ],
                        "rotate": [
                            -132,
                            0
                        ]
                    },
                    "layer": [
                        {
                            "data": {
                                "url": "data/aus_remoteness.geojson",
                                "format": {
                                    "type": "json",
                                    "property": "features"
                                }
                            },
                            "transform": [
                                {
                                    "filter": "focusState === 'All' || datum.properties.state_abbr === focusState"
                                }
                            ],
                            "mark": {
                                "type": "geoshape",
                                "fill": "#DEDAD2",
                                "stroke": "#FBF8F1",
                                "strokeWidth": 0.4
                            }
                        },
                        {
                            "data": {
                                "url": "data/naplan_2025_2026_state_remoteness.csv",
                                "format": {
                                    "type": "csv",
                                    "parse": {
                                        "year": "number",
                                        "year_level": "number",
                                        "pct_strong_or_above": "number",
                                        "enrolled": "number"
                                    }
                                }
                            },
                            "transform": [
                                {
                                    "filter": "datum.year === 2026 && datum.students === 'All students' && (focusState === 'All' || datum.state === focusState) && (domain === 'All' || datum.domain === domain) && datum.year_level === yearLevel && isValid(datum.pct_strong_or_above)"
                                },
                                {
                                    "aggregate": [
                                        {
                                            "op": "mean",
                                            "field": "pct_strong_or_above",
                                            "as": "pct_strong_or_above"
                                        },
                                        {
                                            "op": "mean",
                                            "field": "enrolled",
                                            "as": "enrolled"
                                        }
                                    ],
                                    "groupby": [
                                        "state",
                                        "remoteness"
                                    ]
                                },
                                {
                                    "calculate": "'' + {'NSW': 1, 'VIC': 2, 'QLD': 3, 'SA': 4, 'WA': 5, 'TAS': 6, 'NT': 7, 'ACT': 8}[datum.state] + {'Major cities': 0, 'Inner regional': 1, 'Outer regional': 2, 'Remote': 3, 'Very remote': 4}[datum.remoteness]",
                                    "as": "ra_code"
                                },
                                {
                                    "lookup": "ra_code",
                                    "from": {
                                        "data": {
                                            "url": "data/aus_remoteness.geojson",
                                            "format": {
                                                "type": "json",
                                                "property": "features"
                                            }
                                        },
                                        "key": "properties.ra_code"
                                    },
                                    "as": "geo"
                                },
                                {
                                    "filter": "isValid(datum.geo)"
                                }
                            ],
                            "params": [
                                {
                                    "name": "clickRemote",
                                    "select": {
                                        "type": "point",
                                        "fields": [
                                            "state"
                                        ],
                                        "on": "click",
                                        "clear": "dblclick"
                                    }
                                }
                            ],
                            "mark": {
                                "type": "geoshape",
                                "stroke": "#FBF8F1",
                                "strokeWidth": 0.4,
                                "cursor": "pointer"
                            },
                            "encoding": {
                                "shape": {
                                    "field": "geo",
                                    "type": "geojson"
                                },
                                "color": {
                                    "field": "pct_strong_or_above",
                                    "type": "quantitative",
                                    "title": "% Strong or Exceeding",
                                    "scale": {
                                        "domain": [
                                            0,
                                            80
                                        ],
                                        "range": [
                                            "#D6E2EE",
                                            "#1E3F60"
                                        ],
                                        "interpolate": "lab"
                                    },
                                    "legend": {
                                        "orient": "right",
                                        "direction": "vertical",
                                        "gradientLength": 180,
                                        "values": [
                                            0,
                                            20,
                                            40,
                                            60,
                                            80
                                        ]
                                    }
                                },
                                "tooltip": [
                                    {
                                        "field": "state",
                                        "title": "State"
                                    },
                                    {
                                        "field": "remoteness",
                                        "title": "Remoteness"
                                    },
                                    {
                                        "field": "pct_strong_or_above",
                                        "title": "% Strong or Exceeding",
                                        "format": ".1f"
                                    },
                                    {
                                        "field": "enrolled",
                                        "title": "Students enrolled"
                                    }
                                ]
                            }
                        },
                        {
                            "description": "note for the grey zones, whole-Australia view: text in the ocean south of WA, with a line to Tasmania; a second line points to Victoria's north-west Remote area (blank except in Year 7)",
                            "data": {
                                "values": [
                                    {}
                                ]
                            },
                            "transform": [
                                {
                                    "filter": "focusState === 'All'"
                                }
                            ],
                            "layer": [
                                {
                                    "mark": {
                                        "type": "text",
                                        "align": "left",
                                        "baseline": "middle",
                                        "fontSize": 11,
                                        "fontWeight": 700,
                                        "color": "#2B2A28"
                                    },
                                    "encoding": {
                                        "longitude": {
                                            "datum": 117.0
                                        },
                                        "latitude": {
                                            "datum": -37.2
                                        },
                                        "text": {
                                            "value": "No published result"
                                        }
                                    }
                                },
                                {
                                    "mark": {
                                        "type": "text",
                                        "align": "left",
                                        "baseline": "top",
                                        "fontSize": 10,
                                        "color": "#6B675F",
                                        "dy": 8
                                    },
                                    "encoding": {
                                        "longitude": {
                                            "datum": 117.0
                                        },
                                        "latitude": {
                                            "datum": -37.2
                                        },
                                        "text": {
                                            "value": "(too few students, e.g. remote VIC, or Tasmania 2026)"
                                        }
                                    }
                                },
                                {
                                    "mark": {
                                        "type": "rule",
                                        "color": "#9C968B",
                                        "strokeWidth": 1
                                    },
                                    "encoding": {
                                        "longitude": {
                                            "datum": 134.6
                                        },
                                        "latitude": {
                                            "datum": -38.0
                                        },
                                        "longitude2": {
                                            "datum": 145.2
                                        },
                                        "latitude2": {
                                            "datum": -41.3
                                        }
                                    }
                                },
                                {
                                    "transform": [
                                        {
                                            "filter": "yearLevel !== 7"
                                        }
                                    ],
                                    "mark": {
                                        "type": "rule",
                                        "color": "#9C968B",
                                        "strokeWidth": 1
                                    },
                                    "encoding": {
                                        "longitude": {
                                            "datum": 127.6
                                        },
                                        "latitude": {
                                            "datum": -36.9
                                        },
                                        "longitude2": {
                                            "datum": 141.4
                                        },
                                        "latitude2": {
                                            "datum": -35.8
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "description": "key for the grey zones when zoomed to one state: bottom-left corner",
                            "data": {
                                "values": [
                                    {}
                                ]
                            },
                            "transform": [
                                {
                                    "filter": "focusState !== 'All'"
                                }
                            ],
                            "layer": [
                                {
                                    "mark": {
                                        "type": "square",
                                        "size": 130,
                                        "filled": true,
                                        "color": "#DEDAD2",
                                        "opacity": 1
                                    },
                                    "encoding": {
                                        "x": {
                                            "value": 14
                                        },
                                        "y": {
                                            "value": 428
                                        }
                                    }
                                },
                                {
                                    "mark": {
                                        "type": "text",
                                        "align": "left",
                                        "baseline": "middle",
                                        "fontSize": 11,
                                        "color": "#2B2A28"
                                    },
                                    "encoding": {
                                        "x": {
                                            "value": 24
                                        },
                                        "y": {
                                            "value": 428
                                        },
                                        "text": {
                                            "value": "No published result"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
