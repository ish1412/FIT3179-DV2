{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": {
            "expr": "'Slow gains in the early years, then a new scoring scale: ' + (domain === 'All' ? 'average of subjects' : (domain === 'Grammar and Punctuation' ? 'Grammar & Punctuation' : domain))"
        }
    },
    "width": 700,
    "height": 300,
    "params": [
        {
            "name": "domain",
            "value": "Reading"
        },
        {
            "name": "yearLevel",
            "value": 5
        }
    ],
    "data": {
        "url": "data/naplan_2008_2026_trend_combined.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year": "number",
                "year_level": "number",
                "mean_score": "number"
            }
        }
    },
    "transform": [
        {
            "filter": "datum.state === 'AUS' && isValid(datum.mean_score) && (domain === 'All' || datum.domain === domain)"
        },
        {
            "aggregate": [
                {
                    "op": "mean",
                    "field": "mean_score",
                    "as": "mean_score"
                },
                {
                    "op": "count",
                    "as": "nDomains"
                }
            ],
            "groupby": [
                "year",
                "year_level",
                "era"
            ]
        },
        {
            "filter": "domain !== 'All' || datum.nDomains === 5"
        },
        {
            "calculate": "datum.year < 2020 ? 'old-a' : (datum.year < 2023 ? 'old-b' : 'new')",
            "as": "segment"
        },
        {
            "calculate": "'Year ' + datum.year_level",
            "as": "yearLabel"
        },
        {
            "calculate": "datum.year_level === yearLevel",
            "as": "isSelected"
        },
        {
            "joinaggregate": [
                {
                    "op": "max",
                    "field": "year",
                    "as": "lastYear"
                }
            ],
            "groupby": [
                "year_level"
            ]
        }
    ],
    "encoding": {
        "x": {
            "field": "year",
            "type": "quantitative",
            "title": null,
            "scale": {
                "domain": [
                    2008,
                    2026
                ]
            },
            "axis": {
                "format": "d",
                "values": [
                    2008,
                    2009,
                    2010,
                    2011,
                    2012,
                    2013,
                    2014,
                    2015,
                    2016,
                    2017,
                    2018,
                    2019,
                    2020,
                    2021,
                    2022,
                    2023,
                    2024,
                    2025,
                    2026
                ],
                "grid": false
            }
        }
    },
    "layer": [
        {
            "data": {
                "values": [
                    {
                        "a": 2019.5,
                        "b": 2020.5
                    }
                ]
            },
            "mark": {
                "type": "rect",
                "color": "#ECE6DA",
                "opacity": 0.9
            },
            "encoding": {
                "x": {
                    "field": "a",
                    "type": "quantitative"
                },
                "x2": {
                    "field": "b"
                }
            }
        },
        {
            "data": {
                "values": [
                    {
                        "x": 2022.5
                    }
                ]
            },
            "layer": [
                {
                    "mark": {
                        "type": "rule",
                        "strokeDash": [
                            4,
                            3
                        ],
                        "color": "#2B2A28",
                        "strokeWidth": 1
                    },
                    "encoding": {
                        "x": {
                            "field": "x",
                            "type": "quantitative"
                        }
                    }
                },
                {
                    "mark": {
                        "type": "text",
                        "align": "center",
                        "baseline": "bottom",
                        "dy": -6,
                        "fontSize": 11,
                        "fontWeight": "bold",
                        "color": "#2B2A28",
                        "text": "new test, new scale, not comparable"
                    },
                    "encoding": {
                        "x": {
                            "field": "x",
                            "type": "quantitative"
                        },
                        "y": {
                            "value": 0
                        }
                    }
                }
            ]
        },
        {
            "data": {
                "values": [
                    {
                        "x": 2020
                    }
                ]
            },
            "mark": {
                "type": "text",
                "angle": 270,
                "align": "right",
                "baseline": "middle",
                "fontSize": 10,
                "color": "#8A857B",
                "text": "no test in 2020"
            },
            "encoding": {
                "x": {
                    "field": "x",
                    "type": "quantitative"
                },
                "y": {
                    "value": 6
                }
            }
        },
        {
            "mark": {
                "type": "line"
            },
            "encoding": {
                "y": {
                    "field": "mean_score",
                    "type": "quantitative",
                    "title": "Average score",
                    "scale": {
                        "zero": false
                    }
                },
                "detail": [
                    {
                        "field": "year_level"
                    },
                    {
                        "field": "segment"
                    }
                ],
                "color": {
                    "condition": {
                        "test": "datum.isSelected",
                        "value": "#1E3F60"
                    },
                    "value": "#C9C3B7"
                },
                "strokeWidth": {
                    "condition": {
                        "test": "datum.isSelected",
                        "value": 3
                    },
                    "value": 1.6
                }
            },
            "transform": [
                {
                    "filter": "!datum.isSelected"
                }
            ]
        },
        {
            "mark": {
                "type": "point",
                "filled": true
            },
            "encoding": {
                "y": {
                    "field": "mean_score",
                    "type": "quantitative"
                },
                "color": {
                    "condition": {
                        "test": "datum.isSelected",
                        "value": "#1E3F60"
                    },
                    "value": "#C9C3B7"
                },
                "size": {
                    "condition": {
                        "test": "datum.isSelected",
                        "value": 40
                    },
                    "value": 18
                },
                "tooltip": [
                    {
                        "field": "yearLabel",
                        "title": "Year level"
                    },
                    {
                        "field": "year",
                        "title": "Year",
                        "format": "d"
                    },
                    {
                        "field": "mean_score",
                        "title": "Average score",
                        "format": ".1f"
                    },
                    {
                        "field": "era",
                        "title": "Test scale"
                    }
                ]
            },
            "transform": [
                {
                    "filter": "!datum.isSelected"
                }
            ]
        },
        {
            "mark": {
                "type": "line"
            },
            "encoding": {
                "y": {
                    "field": "mean_score",
                    "type": "quantitative",
                    "title": "Average score",
                    "scale": {
                        "zero": false
                    }
                },
                "detail": [
                    {
                        "field": "year_level"
                    },
                    {
                        "field": "segment"
                    }
                ],
                "color": {
                    "condition": {
                        "test": "datum.isSelected",
                        "value": "#1E3F60"
                    },
                    "value": "#C9C3B7"
                },
                "strokeWidth": {
                    "condition": {
                        "test": "datum.isSelected",
                        "value": 3
                    },
                    "value": 1.6
                }
            },
            "transform": [
                {
                    "filter": "datum.isSelected"
                }
            ]
        },
        {
            "mark": {
                "type": "point",
                "filled": true
            },
            "encoding": {
                "y": {
                    "field": "mean_score",
                    "type": "quantitative"
                },
                "color": {
                    "condition": {
                        "test": "datum.isSelected",
                        "value": "#1E3F60"
                    },
                    "value": "#C9C3B7"
                },
                "size": {
                    "condition": {
                        "test": "datum.isSelected",
                        "value": 40
                    },
                    "value": 18
                },
                "tooltip": [
                    {
                        "field": "yearLabel",
                        "title": "Year level"
                    },
                    {
                        "field": "year",
                        "title": "Year",
                        "format": "d"
                    },
                    {
                        "field": "mean_score",
                        "title": "Average score",
                        "format": ".1f"
                    },
                    {
                        "field": "era",
                        "title": "Test scale"
                    }
                ]
            },
            "transform": [
                {
                    "filter": "datum.isSelected"
                }
            ]
        },
        {
            "transform": [
                {
                    "filter": "datum.year === datum.lastYear && !datum.isSelected"
                }
            ],
            "mark": {
                "type": "text",
                "align": "left",
                "dx": 8,
                "fontSize": 11
            },
            "encoding": {
                "y": {
                    "field": "mean_score",
                    "type": "quantitative"
                },
                "text": {
                    "field": "yearLabel"
                },
                "color": {
                    "condition": {
                        "test": "datum.isSelected",
                        "value": "#1E3F60"
                    },
                    "value": "#8A857B"
                }
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.year === datum.lastYear && datum.isSelected"
                }
            ],
            "mark": {
                "type": "text",
                "align": "left",
                "dx": 8,
                "fontSize": 11,
                "fontWeight": "bold"
            },
            "encoding": {
                "y": {
                    "field": "mean_score",
                    "type": "quantitative"
                },
                "text": {
                    "field": "yearLabel"
                },
                "color": {
                    "condition": {
                        "test": "datum.isSelected",
                        "value": "#1E3F60"
                    },
                    "value": "#8A857B"
                }
            }
        }
    ]
}
