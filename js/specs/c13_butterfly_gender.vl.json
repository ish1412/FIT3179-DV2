{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "Girls lead in words, boys in numbers",
    "width": 200,
    "height": 190,
    "params": [
        {
            "name": "domain",
            "value": "Reading"
        },
        {
            "name": "yearLevel",
            "value": 5
        }
    ],
    "data": {
        "url": "data/naplan_2023_2026_subgroups_aus.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year": "number",
                "year_level": "number",
                "pct_strong_or_above": "number"
            }
        }
    },
    "transform": [
        {
            "filter": "datum.year === 2026 && datum.attribute === 'Gender' && datum.year_level === yearLevel"
        },
        {
            "calculate": "datum.subgroup === 'Female' ? 'Girls' : 'Boys'",
            "as": "gender"
        },
        {
            "calculate": "datum.gender === 'Girls' ? -datum.pct_strong_or_above : datum.pct_strong_or_above",
            "as": "signed"
        },
        {
            "calculate": "datum.domain === 'Grammar and Punctuation' ? 'Grammar & Punct.' : datum.domain",
            "as": "domainLabel"
        },
        {
            "calculate": "indexof(['Reading', 'Writing', 'Spelling', 'Grammar and Punctuation', 'Numeracy'], datum.domain)",
            "as": "domainOrder"
        },
        {
            "joinaggregate": [
                {
                    "op": "sum",
                    "field": "signed",
                    "as": "boysMinusGirls"
                }
            ],
            "groupby": [
                "domain"
            ]
        }
    ],
    "encoding": {
        "y": {
            "field": "domainLabel",
            "type": "nominal",
            "title": null,
            "sort": [
                "Reading",
                "Writing",
                "Spelling",
                "Grammar & Punct.",
                "Numeracy"
            ],
            "axis": {
                "domain": false,
                "ticks": false,
                "labelPadding": 6
            }
        }
    },
    "layer": [
        {
            "mark": {
                "type": "bar",
                "height": {
                    "band": 0.55
                }
            },
            "encoding": {
                "x": {
                    "field": "signed",
                    "type": "quantitative",
                    "title": "<- Girls   |   Boys ->",
                    "scale": {
                        "domain": [
                            -100,
                            100
                        ]
                    },
                    "axis": {
                        "labelExpr": "abs(datum.value)",
                        "values": [
                            -100,
                            -50,
                            0,
                            50,
                            100
                        ]
                    }
                },
                "color": {
                    "field": "gender",
                    "type": "nominal",
                    "title": null,
                    "scale": {
                        "domain": [
                            "Girls",
                            "Boys"
                        ],
                        "range": [
                            "#A8436B",
                            "#5E6B2C"
                        ]
                    },
                    "legend": null
                },
                "opacity": {
                    "condition": {
                        "test": "domain === 'All' || datum.domain === domain",
                        "value": 1
                    },
                    "value": 0.65
                },
                "tooltip": [
                    {
                        "field": "domain",
                        "title": "Domain"
                    },
                    {
                        "field": "gender",
                        "title": "Students"
                    },
                    {
                        "field": "pct_strong_or_above",
                        "title": "% Strong or Exceeding",
                        "format": ".1f"
                    },
                    {
                        "field": "boysMinusGirls",
                        "title": "Boys minus girls (percentage points)",
                        "format": "+.1f"
                    }
                ]
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.gender === 'Girls'"
                }
            ],
            "mark": {
                "type": "text",
                "align": "left",
                "dx": 4,
                "fontSize": 10,
                "color": "#FFFFFF",
                "fontWeight": "bold"
            },
            "encoding": {
                "x": {
                    "field": "signed",
                    "type": "quantitative"
                },
                "text": {
                    "field": "pct_strong_or_above",
                    "type": "quantitative",
                    "format": ".0f"
                }
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.gender === 'Boys'"
                }
            ],
            "mark": {
                "type": "text",
                "align": "right",
                "dx": -4,
                "fontSize": 10,
                "color": "#FFFFFF",
                "fontWeight": "bold"
            },
            "encoding": {
                "x": {
                    "field": "signed",
                    "type": "quantitative"
                },
                "text": {
                    "field": "pct_strong_or_above",
                    "type": "quantitative",
                    "format": ".0f"
                }
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.gender === 'Boys'"
                }
            ],
            "mark": {
                "type": "text",
                "align": "left",
                "dx": 4,
                "fontSize": 10,
                "color": "#6B675F"
            },
            "encoding": {
                "x": {
                    "datum": 100,
                    "type": "quantitative"
                },
                "text": {
                    "field": "boysMinusGirls",
                    "type": "quantitative",
                    "format": "+.0f"
                }
            }
        },
        {
            "description": "callout: boys lead in numeracy in every year level (2026)",
            "data": {
                "values": [
                    {}
                ]
            },
            "layer": [
                {
                    "mark": {
                        "type": "rule",
                        "color": "#2B2A28",
                        "strokeWidth": 1.2
                    },
                    "encoding": {
                        "x": {
                            "datum": 60
                        },
                        "y": {
                            "value": {
                                "expr": "height + 46"
                            }
                        },
                        "y2": {
                            "value": {
                                "expr": "height + 4"
                            }
                        }
                    }
                },
                {
                    "mark": {
                        "type": "point",
                        "shape": "triangle-up",
                        "filled": true,
                        "size": 55,
                        "color": "#2B2A28",
                        "opacity": 1
                    },
                    "encoding": {
                        "x": {
                            "datum": 60
                        },
                        "y": {
                            "value": {
                                "expr": "height + 3"
                            }
                        }
                    }
                },
                {
                    "mark": {
                        "type": "rect",
                        "fill": "#FFFFFF",
                        "stroke": "#2B2A28",
                        "strokeWidth": 1,
                        "cornerRadius": 3
                    },
                    "encoding": {
                        "x": {
                            "datum": 15
                        },
                        "x2": {
                            "datum": 100
                        },
                        "y": {
                            "value": {
                                "expr": "height + 46"
                            }
                        },
                        "y2": {
                            "value": {
                                "expr": "height + 84"
                            }
                        }
                    }
                },
                {
                    "mark": {
                        "type": "text",
                        "align": "left",
                        "baseline": "top",
                        "fontSize": 11,
                        "lineHeight": 14,
                        "color": "#2B2A28",
                        "dx": 7
                    },
                    "encoding": {
                        "x": {
                            "datum": 15
                        },
                        "y": {
                            "value": {
                                "expr": "height + 52"
                            }
                        },
                        "text": {
                            "value": [
                                "Boys lead in numeracy",
                                "in all year levels"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}
