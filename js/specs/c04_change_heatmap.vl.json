{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "Three years on, little has shifted · 2023 to 2026",
    "width": 190,
    "height": 200,
    "data": {
        "url": "data/naplan_2023_2026_states.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year": "number",
                "year_level": "number",
                "pct_strong_or_above": "number"
            }
        }
    },
    "transform": [
        {
            "filter": "datum.state === 'AUS' && (datum.year === 2023 || datum.year === 2026)"
        },
        {
            "pivot": "year",
            "value": "pct_strong_or_above",
            "groupby": [
                "domain",
                "year_level"
            ]
        },
        {
            "calculate": "datum['2026'] - datum['2023']",
            "as": "change"
        },
        {
            "calculate": "abs(datum.change)",
            "as": "absChange"
        },
        {
            "window": [
                {
                    "op": "row_number",
                    "as": "sizeRank"
                }
            ],
            "sort": [
                {
                    "field": "absChange",
                    "order": "descending"
                }
            ]
        },
        {
            "calculate": "'Year ' + datum.year_level",
            "as": "yearLabel"
        },
        {
            "calculate": "datum.domain === 'Grammar and Punctuation' ? 'Grammar & Punct.' : datum.domain",
            "as": "domainLabel"
        },
        {
            "calculate": "indexof(['Reading', 'Writing', 'Spelling', 'Grammar and Punctuation', 'Numeracy'], datum.domain)",
            "as": "domainOrder"
        }
    ],
    "encoding": {
        "x": {
            "field": "yearLabel",
            "type": "ordinal",
            "title": null,
            "axis": {
                "orient": "top",
                "labelAngle": 0,
                "domain": false,
                "ticks": false
            }
        },
        "y": {
            "field": "domainLabel",
            "type": "nominal",
            "sort": [
                "Reading",
                "Writing",
                "Spelling",
                "Grammar & Punct.",
                "Numeracy"
            ],
            "title": null,
            "axis": {
                "domain": false,
                "ticks": false
            }
        }
    },
    "layer": [
        {
            "mark": {
                "type": "rect",
                "stroke": "#FBF8F1",
                "strokeWidth": 2
            },
            "encoding": {
                "color": {
                    "field": "change",
                    "type": "quantitative",
                    "title": "Change from 2023 to 2026 (percentage points)",
                    "scale": {
                        "domain": [
                            -4,
                            0,
                            4
                        ],
                        "range": [
                            "#C8652B",
                            "#F2EEE6",
                            "#2F5D8A"
                        ],
                        "interpolate": "lab"
                    },
                    "legend": {
                        "orient": "bottom",
                        "direction": "horizontal",
                        "gradientLength": 160,
                        "values": [
                            -4,
                            -2,
                            0,
                            2,
                            4
                        ],
                        "offset": 78,
                        "titleLimit": 500
                    }
                },
                "tooltip": [
                    {
                        "field": "domain",
                        "title": "Domain"
                    },
                    {
                        "field": "yearLabel",
                        "title": "Year level"
                    },
                    {
                        "field": "2023",
                        "title": "2023 % Strong+",
                        "type": "quantitative",
                        "format": ".1f"
                    },
                    {
                        "field": "2026",
                        "title": "2026 % Strong+",
                        "type": "quantitative",
                        "format": ".1f"
                    },
                    {
                        "field": "change",
                        "title": "Change from 2023 to 2026 (percentage points)",
                        "type": "quantitative",
                        "format": "+.1f"
                    }
                ]
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.sizeRank <= 4"
                }
            ],
            "mark": {
                "type": "text",
                "fontSize": 11,
                "fontWeight": "bold"
            },
            "encoding": {
                "text": {
                    "field": "change",
                    "type": "quantitative",
                    "format": "+.1f"
                },
                "color": {
                    "condition": {
                        "test": "datum.absChange >= 2.5",
                        "value": "#FFFFFF"
                    },
                    "value": "#2B2A28"
                }
            }
        },
        {
            "description": "callout: biggest rise (Year 5 Numeracy, bottom row): box under Years 3-5, arrow straight up into the cell",
            "data": {
                "values": [
                    {}
                ]
            },
            "layer": [
                {
                    "mark": {
                        "type": "rule",
                        "color": "#2B2A28",
                        "strokeWidth": 1.2
                    },
                    "encoding": {
                        "x": {
                            "value": {
                                "expr": "width * 0.375"
                            }
                        },
                        "x2": {
                            "value": {
                                "expr": "width * 0.375"
                            }
                        },
                        "y": {
                            "value": {
                                "expr": "height + 16"
                            }
                        },
                        "y2": {
                            "value": {
                                "expr": "height + 7"
                            }
                        }
                    }
                },
                {
                    "mark": {
                        "type": "point",
                        "shape": "triangle-up",
                        "filled": true,
                        "size": 60,
                        "color": "#2B2A28",
                        "opacity": 1
                    },
                    "encoding": {
                        "x": {
                            "value": {
                                "expr": "width * 0.375"
                            }
                        },
                        "y": {
                            "value": {
                                "expr": "height + 5"
                            }
                        }
                    }
                },
                {
                    "mark": {
                        "type": "rect",
                        "fill": "#FFFFFF",
                        "stroke": "#2B2A28",
                        "strokeWidth": 1,
                        "cornerRadius": 3
                    },
                    "encoding": {
                        "x": {
                            "value": {
                                "expr": "0"
                            }
                        },
                        "x2": {
                            "value": {
                                "expr": "width * 0.5 - 6"
                            }
                        },
                        "y": {
                            "value": {
                                "expr": "height + 16"
                            }
                        },
                        "y2": {
                            "value": {
                                "expr": "height + 64"
                            }
                        }
                    }
                },
                {
                    "mark": {
                        "type": "text",
                        "align": "left",
                        "baseline": "top",
                        "fontSize": 11,
                        "lineHeight": 14,
                        "color": "#2B2A28"
                    },
                    "encoding": {
                        "x": {
                            "value": {
                                "expr": "0 + 8"
                            }
                        },
                        "y": {
                            "value": {
                                "expr": "height + 16 + 7"
                            }
                        },
                        "text": {
                            "value": [
                                "Biggest rise: +3.0",
                                "its best since the 2023 reset (ACARA)"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "description": "callout: biggest fall (Year 7 Grammar, row 4): box under Years 7-9, arrow runs up the white gap between Year 7 and Year 9 then left into the cell",
            "data": {
                "values": [
                    {}
                ]
            },
            "layer": [
                {
                    "mark": {
                        "type": "rule",
                        "color": "#2B2A28",
                        "strokeWidth": 1.2
                    },
                    "encoding": {
                        "x": {
                            "value": {
                                "expr": "width * 0.75"
                            }
                        },
                        "x2": {
                            "value": {
                                "expr": "width * 0.75"
                            }
                        },
                        "y": {
                            "value": {
                                "expr": "height + 16"
                            }
                        },
                        "y2": {
                            "value": {
                                "expr": "height * 0.7"
                            }
                        }
                    }
                },
                {
                    "mark": {
                        "type": "rule",
                        "color": "#2B2A28",
                        "strokeWidth": 1.2
                    },
                    "encoding": {
                        "x": {
                            "value": {
                                "expr": "width * 0.75"
                            }
                        },
                        "x2": {
                            "value": {
                                "expr": "width * 0.75 - 8"
                            }
                        },
                        "y": {
                            "value": {
                                "expr": "height * 0.7"
                            }
                        },
                        "y2": {
                            "value": {
                                "expr": "height * 0.7"
                            }
                        }
                    }
                },
                {
                    "mark": {
                        "type": "point",
                        "shape": "triangle-left",
                        "filled": true,
                        "size": 60,
                        "color": "#2B2A28",
                        "opacity": 1
                    },
                    "encoding": {
                        "x": {
                            "value": {
                                "expr": "width * 0.75 - 9"
                            }
                        },
                        "y": {
                            "value": {
                                "expr": "height * 0.7"
                            }
                        }
                    }
                },
                {
                    "mark": {
                        "type": "rect",
                        "fill": "#FFFFFF",
                        "stroke": "#2B2A28",
                        "strokeWidth": 1,
                        "cornerRadius": 3
                    },
                    "encoding": {
                        "x": {
                            "value": {
                                "expr": "width * 0.5 + 6"
                            }
                        },
                        "x2": {
                            "value": {
                                "expr": "width"
                            }
                        },
                        "y": {
                            "value": {
                                "expr": "height + 16"
                            }
                        },
                        "y2": {
                            "value": {
                                "expr": "height + 64"
                            }
                        }
                    }
                },
                {
                    "mark": {
                        "type": "text",
                        "align": "left",
                        "baseline": "top",
                        "fontSize": 11,
                        "lineHeight": 14,
                        "color": "#2B2A28"
                    },
                    "encoding": {
                        "x": {
                            "value": {
                                "expr": "width * 0.5 + 6 + 8"
                            }
                        },
                        "y": {
                            "value": {
                                "expr": "height + 16 + 7"
                            }
                        },
                        "text": {
                            "value": [
                                "Biggest fall: −3.9",
                                "its lowest since the 2023 reset"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}
