{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": {
            "expr": "'How do the states rank? · ' + (domain === 'All' ? 'average of subjects' : (domain === 'Grammar and Punctuation' ? 'Grammar & Punctuation' : domain))"
        }
    },
    "width": 150,
    "height": 170,
    "params": [
        {
            "name": "domain",
            "value": "Reading"
        },
        {
            "name": "yearLevel",
            "value": 5
        },
        {
            "name": "highlight",
            "value": ""
        }
    ],
    "data": {
        "url": "data/naplan_2023_2026_states.csv",
        "format": {
            "type": "csv",
            "parse": {
                "year": "number",
                "year_level": "number",
                "pct_strong_or_above": "number"
            }
        }
    },
    "transform": [
        {
            "filter": "datum.state !== 'AUS' && (domain === 'All' || datum.domain === domain) && datum.year_level === yearLevel"
        },
        {
            "aggregate": [
                {
                    "op": "mean",
                    "field": "pct_strong_or_above",
                    "as": "pct_strong_or_above"
                }
            ],
            "groupby": [
                "state",
                "state_name",
                "year"
            ]
        },
        {
            "window": [
                {
                    "op": "rank",
                    "as": "rank"
                }
            ],
            "groupby": [
                "year"
            ],
            "sort": [
                {
                    "field": "pct_strong_or_above",
                    "order": "descending"
                }
            ]
        },
        {
            "joinaggregate": [
                {
                    "op": "max",
                    "field": "year",
                    "as": "lastYear"
                }
            ],
            "groupby": [
                "state"
            ]
        },
        {
            "calculate": "highlight === '' || datum.state === highlight",
            "as": "isOn"
        }
    ],
    "encoding": {
        "x": {
            "field": "year",
            "type": "ordinal",
            "title": null,
            "axis": {
                "labelAngle": 0,
                "domain": false,
                "ticks": false
            }
        },
        "y": {
            "field": "rank",
            "type": "ordinal",
            "title": "Position",
            "axis": {
                "labelExpr": "datum.value + (datum.value == 1 ? 'st' : datum.value == 2 ? 'nd' : datum.value == 3 ? 'rd' : 'th')",
                "domain": false,
                "ticks": false,
                "labelPadding": 10,
                "titlePadding": 10,
                "labelFontWeight": "bold"
            }
        },
        "detail": {
            "field": "state"
        },
        "opacity": {
            "condition": {
                "test": "datum.isOn",
                "value": 1
            },
            "value": 0.15
        },
        "color": {
            "field": "state",
            "type": "nominal",
            "legend": null,
            "scale": {
                "domain": [
                    "NSW",
                    "VIC",
                    "QLD",
                    "SA",
                    "WA",
                    "TAS",
                    "NT",
                    "ACT"
                ],
                "range": [
                    "#3D8FD1",
                    "#0B2A5B",
                    "#7A1F3D",
                    "#D2232A",
                    "#C99700",
                    "#00704A",
                    "#B8571C",
                    "#6BA539"
                ]
            }
        }
    },
    "layer": [
        {
            "mark": {
                "type": "line",
                "strokeWidth": 2
            },
            "encoding": {}
        },
        {
            "mark": {
                "type": "circle",
                "size": 70
            },
            "encoding": {
                "tooltip": [
                    {
                        "field": "state_name",
                        "title": "State"
                    },
                    {
                        "field": "year",
                        "title": "Year"
                    },
                    {
                        "field": "rank",
                        "title": "Rank"
                    },
                    {
                        "field": "pct_strong_or_above",
                        "title": "% Strong or Exceeding",
                        "format": ".1f"
                    }
                ]
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.year === datum.lastYear"
                }
            ],
            "mark": {
                "type": "text",
                "align": "left",
                "dx": 8,
                "fontSize": 10,
                "fontWeight": "bold"
            },
            "encoding": {
                "text": {
                    "field": "state"
                }
            }
        },
        {
            "data": {
                "values": [
                    {
                        "note": "TAS stops at 2025: 2026 not published"
                    }
                ]
            },
            "mark": {
                "type": "text",
                "align": "left",
                "baseline": "top",
                "fontSize": 10,
                "color": "#6B675F"
            },
            "encoding": {
                "x": {
                    "value": 0
                },
                "y": {
                    "value": 196
                },
                "text": {
                    "field": "note"
                },
                "opacity": {
                    "value": 1
                },
                "color": {
                    "value": "#6B675F"
                }
            }
        }
    ]
}
